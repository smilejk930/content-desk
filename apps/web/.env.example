# Firebase 웹 앱 공개 설정값 (Firebase 콘솔 -> 프로젝트 설정 -> 일반 -> 내 앱)
# 실제 값은 apps/web/.env.local (Git 무시) 또는 Cloudflare Pages 환경 변수에 입력
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=content-desk-b9c3d.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=content-desk-b9c3d
VITE_FIREBASE_STORAGE_BUCKET=content-desk-b9c3d.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 프로덕션 배포 시 Worker 출처 URL 지정 (예: https://content-desk-worker.<서브도메인>.workers.dev)
# vite build 시 dist/_headers의 CSP connect-src에 해당 출처가 자동 추가됩니다.
# 로컬 개발 시 비워 두면 Vite dev 서버가 /api를 http://127.0.0.1:8787로 프록시합니다.
VITE_API_BASE_URL=
